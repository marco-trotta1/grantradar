# Required. Use values from the GrantRadar Supabase project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Used only for the signed-in user's account deletion.
SUPABASE_SECRET_KEY=

# Optional. Federal grant search works without a key.
# Set this value only on the server. Do not use a NEXT_PUBLIC_ prefix.
TAVILY_API_KEY=
